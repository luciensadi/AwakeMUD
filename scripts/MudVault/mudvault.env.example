# Example environment for the MudVault integration.
# Copy this to `mudvault.env`, fill in the real values, then:
#   chown root:root mudvault.env && chmod 600 mudvault.env
# Source it (e.g. `set -a; . ./mudvault.env; set +a`) before running
# `python3 -m monoscript.main`, or feed it to the systemd service for webhooks.

# HMAC secret for the incoming reward webhook. Found on the "Edit MUD" page of
# mudvault.org when you configure the webhook URL.
MUDVAULT_WEBHOOK_SECRET=your_webhook_secret_here

# API key issued when you enable the voting rewards system. main.py composes
# the X-API-Key header as mv_<MUD_ID>_<API_KEY>.
MUDVAULT_API_KEY=your_api_key_here

# Your MudVault MUD id. This deployment is MUD id 17.
MUDVAULT_MUD_ID=17

# MySQL connection for the game database ("AwakeMUD"). The pfiles table,
# mudvault_votes, and mudvault_character_linking all live there.
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=AwakeMUD

# MySQL user scoping:
#   * The web service (webhooks receiver) DB user should be INSERT-only on
#     mudvault_votes, plus SELECT on pfiles (needed by the trigger that copies
#     votes into the game).
#   * The cron/monoscript DB user needs read/write on the mudvault_* tables
#     (mudvault_votes, mudvault_character_linking, and related status columns).
